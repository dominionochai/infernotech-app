# Copy this file to .env before running app.py (or export these in your shell).
# Every integration below degrades gracefully if unset — the app never
# breaks, it just falls back to demo data / skips that layer.

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash

# Free, instant signup: https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY=your-nasa-firms-map-key-here

# --- Ridgeline (ground-camera confirmation) ---
# Set once you're running Ridgeline (github.com/ayaan-gupta/ridgeline)
# alongside this app, e.g. via docker-compose. Point it at Ridgeline's web
# service URL.
RIDGELINE_API_URL=http://localhost:3100

# --- Hedera Guardian (carbon-credit MRV submission) ---
# Set once you have a running Guardian instance (github.com/hashgraph/guardian)
# with the VM0015 "Avoided Unplanned Deforestation" policy imported and an
# owner DID registered against it.
GUARDIAN_API_URL=http://localhost:3000/api/v1
GUARDIAN_OWNER_DID=did:hedera:testnet:your-registered-did
GUARDIAN_POLICY_TAG=MRV_VM0015
GUARDIAN_ACCESS_TOKEN=your-guardian-bearer-token-here
